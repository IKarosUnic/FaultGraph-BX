/**
 * Suite 32 - EcosystemAndInterceptionTest.bx
 *
 * Banco de pruebas formal para la integracion con el ecosistema Ortus / ColdBox / CommandBox:
 *   - TC-ECO-01: FaultGraphInterceptor captura onException y sanitiza parametros sensibles.
 *   - TC-ECO-02: FaultGraphInterceptor autodiagnostica excepciones y genera diagramas Mermaid.
 *   - TC-ECO-03: FaultGraphInterceptor respeta la retencion acotada en memoria (maxIncidents).
 *   - TC-ECO-04: AstTransformer transforma accesos riesgosos en Elvis seguro y valida sintaxis.
 *   - TC-ECO-05: AstTransformer envuelve funciones con try/catch defensivo y genera diffs.
 *   - TC-ECO-06: commands.faultgraph despacha acciones CLI (doctor, help, scan) de CommandBox.
 */
class {

    public any function init( required string rootDir, required any reporter, required any assert ) {
        variables.rootDir  = arguments.rootDir;
        variables.reporter = arguments.reporter;
        variables.assert   = arguments.assert;
        variables.config   = new config.Config( arguments.rootDir );
        return this;
    }

    public void function run() {
        testColdBoxExceptionInterception();
        testAutoDiagnosticAndMermaid();
        testBoundedMemoryRetention();
        testAstTransformerSafeElvis();
        testAstTransformerTryCatchWrapping();
        testCommandBoxCliDispatch();
    }

    /**
     * TC-ECO-01: FaultGraphInterceptor captura onException y sanitiza parametros sensibles
     */
    private void function testColdBoxExceptionInterception() {
        var id = "TC-ECO-01";
        var scenario = "FaultGraphInterceptor: captura de onException y sanitizacion de parametros sensibles";
        var t0 = getTickCount();
        try {
            var interceptor = new models.interceptors.FaultGraphInterceptor( variables.config );
            
            var mockRc = {
                "orderId": "ORD-12345",
                "amount": 99.50,
                "apiKey": "sk_live_SECRET_KEY_999",
                "password": "SuperSecretPassword123"
            };
            var mockExc = {
                "message": "Null Pointer encountered in PaymentGateway",
                "detail": "Variable config.gatewayUrl is null",
                "type": "java.lang.NullPointerException",
                "stackTrace": "at models.PaymentGateway.charge(PaymentGateway.bx:45)\nat services.OrderService.process(OrderService.bx:102)"
            };

            var incident = interceptor.onException( { "route": "api/v1/checkout" }, mockRc, {}, mockExc );

            variables.assert.isTrue( !isNull( incident.id ), "Genera identificador de incidente" );
            variables.assert.isTrue( incident.context.apiKey == "[REDACTED]", "Sanitiza apiKey sensible" );
            variables.assert.isTrue( incident.context.password == "[REDACTED]", "Sanitiza password sensible" );
            variables.assert.isTrue( incident.context.orderId == "ORD-12345", "Mantiene intactos parametros no sensibles" );
            variables.assert.isTrue( incident.severity == "CRITICAL", "Clasifica como CRITICAL ante NullPointerException" );
            variables.assert.isTrue( interceptor.getIncidentCount() == 1, "Incrementa el contador de incidentes" );

            variables.reporter.record( id, scenario, "Parametros sanitizados y clasificado CRITICAL", "Captura correcta", "PASS", "PASS", getTickCount() - t0 );
        } catch ( any e ) {
            variables.reporter.record( id, scenario, "Exito", "Fallo", e.message, "FAIL", getTickCount() - t0, e.detail );
        }
    }

    /**
     * TC-ECO-02: FaultGraphInterceptor autodiagnostica excepciones y genera diagramas Mermaid
     */
    private void function testAutoDiagnosticAndMermaid() {
        var id = "TC-ECO-02";
        var scenario = "FaultGraphInterceptor: autodiagnostico de trazas y sintesis reactiva de diagrama Mermaid";
        var t0 = getTickCount();
        try {
            var interceptor = new models.interceptors.FaultGraphInterceptor( variables.config );
            var mockExc = {
                "message": "Timeout in PaymentService",
                "detail": "Connection timed out",
                "type": "TimeoutException",
                "stackTrace": "at services.PaymentService.charge(PaymentService.bx:30)\nCaused by: SocketTimeoutException"
            };

            var incident = interceptor.captureException( mockExc, { "userId": 42 } );

            variables.assert.isTrue( structKeyExists( incident, "diagnostic" ), "Ejecuta autodiagnostico de la excepcion" );
            variables.assert.isTrue( structKeyExists( incident, "mermaid" ), "Genera representacion Mermaid del incidente" );
            variables.assert.isTrue( find( "flowchart", incident.mermaid ) > 0, "El diagrama Mermaid contiene cabecera flowchart" );

            variables.reporter.record( id, scenario, "Diagnostico y Mermaid generados", "Diagnostico presente", "PASS", "PASS", getTickCount() - t0 );
        } catch ( any e ) {
            variables.reporter.record( id, scenario, "Exito", "Fallo", e.message, "FAIL", getTickCount() - t0, e.detail );
        }
    }

    /**
     * TC-ECO-03: FaultGraphInterceptor respeta la retencion acotada en memoria (maxIncidents)
     */
    private void function testBoundedMemoryRetention() {
        var id = "TC-ECO-03";
        var scenario = "FaultGraphInterceptor: retencion acotada en memoria de incidentes (FIFO safe buffer)";
        var t0 = getTickCount();
        try {
            var interceptor = new models.interceptors.FaultGraphInterceptor( variables.config );
            interceptor.clearIncidents();

            // Enviar 105 incidentes (limite default es 100)
            for ( var i = 1; i <= 105; i++ ) {
                interceptor.captureException( { "message": "Error " & i, "stackTrace": "" } );
            }

            variables.assert.isTrue( interceptor.getIncidentCount() <= 100, "Limita estrictamente la memoria a maxIncidents" );
            
            interceptor.clearIncidents();
            variables.assert.isTrue( interceptor.getIncidentCount() == 0, "clearIncidents() vacia correctamente el historial" );

            variables.reporter.record( id, scenario, "Memoria acotada <= 100 y vaciado limpio", "Buffer respetado", "PASS", "PASS", getTickCount() - t0 );
        } catch ( any e ) {
            variables.reporter.record( id, scenario, "Exito", "Fallo", e.message, "FAIL", getTickCount() - t0, e.detail );
        }
    }

    /**
     * TC-ECO-04: AstTransformer transforma accesos riesgosos en Elvis seguro y valida sintaxis
     */
    private void function testAstTransformerSafeElvis() {
        var id = "TC-ECO-04";
        var scenario = "AstTransformer: inyeccion de operador de navegacion segura y Elvis con validacion AST";
        var t0 = getTickCount();
        try {
            var transformer = new models.ast.AstTransformer();
            var code = 'class { public numeric function calc( struct config ) { return config.taxRate * 100; } }';

            var result = transformer.injectSafeElvis( code, "config.taxRate", "0" );

            variables.assert.isTrue( result.ok, "Transformacion sintactica exitosa" );
            variables.assert.isTrue( result.modified, "Codigo efectivamente modificado" );
            variables.assert.isTrue( find( "config?.taxRate ?: 0", result.transformed ) > 0, "Contiene operador seguro Elvis" );
            variables.assert.isTrue( len( result.diff ) > 0, "Genera diff unificado" );

            variables.reporter.record( id, scenario, "Operador Elvis inyectado y sintaxis valida", "Sintaxis verificada", "PASS", "PASS", getTickCount() - t0 );
        } catch ( any e ) {
            variables.reporter.record( id, scenario, "Exito", "Fallo", e.message, "FAIL", getTickCount() - t0, e.detail );
        }
    }

    /**
     * TC-ECO-05: AstTransformer envuelve funciones con try/catch defensivo y genera diffs
     */
    private void function testAstTransformerTryCatchWrapping() {
        var id = "TC-ECO-05";
        var scenario = "AstTransformer: envoltorio defensivo de metodos con try/catch y sintesis de diff";
        var t0 = getTickCount();
        try {
            var transformer = new models.ast.AstTransformer();
            var code = 'class {' & char(10) & '    public any function execute() {' & char(10) & '        var x = 10 / 0;' & char(10) & '        return x;' & char(10) & '    }' & char(10) & '}';

            var result = transformer.wrapWithTryCatch( code, "execute", 'return { "ok": false, "error": e.message };' );

            variables.assert.isTrue( result.ok, "Envoltura defensiva con try/catch exitosa" );
            variables.assert.isTrue( result.modified, "Codigo estructuralmente alterado" );
            variables.assert.isTrue( find( "try {", result.transformed ) > 0, "Bloque try inyectado" );
            variables.assert.isTrue( find( "catch ( any e ) {", result.transformed ) > 0, "Bloque catch inyectado con compensacion" );

            variables.reporter.record( id, scenario, "Try/Catch inyectado con diff unificado", "Estructura valida", "PASS", "PASS", getTickCount() - t0 );
        } catch ( any e ) {
            variables.reporter.record( id, scenario, "Exito", "Fallo", e.message, "FAIL", getTickCount() - t0, e.detail );
        }
    }

    /**
     * TC-ECO-06: commands.faultgraph despacha acciones CLI (doctor, help, scan) de CommandBox
     */
    private void function testCommandBoxCliDispatch() {
        var id = "TC-ECO-06";
        var scenario = "commands.faultgraph: despacho unificado de comandos CLI (doctor, help, scan) para CommandBox";
        var t0 = getTickCount();
        try {
            var cmd = new commands.faultgraph();

            var doctorRes = cmd.run( action = "doctor" );
            variables.assert.isTrue( doctorRes.ok, "Comando doctor ejecuta y reporta ok" );
            variables.assert.isTrue( doctorRes.cloudTokensUsed == 0, "Doctor confirma 0 tokens en la nube" );

            var helpRes = cmd.run( action = "help" );
            variables.assert.isTrue( find( "box faultgraph", helpRes ) > 0, "Comando help documenta la sintaxis CLI" );

            var scanRes = cmd.run( action = "scan", target = "target_app" );
            variables.assert.isTrue( scanRes.ok, "Comando scan analiza el directorio objetivo" );

            variables.reporter.record( id, scenario, "Comandos doctor, help y scan despachados exitosamente", "Despacho CLI OK", "PASS", "PASS", getTickCount() - t0 );
        } catch ( any e ) {
            variables.reporter.record( id, scenario, "Exito", "Fallo", e.message, "FAIL", getTickCount() - t0, e.detail );
        }
    }

}
