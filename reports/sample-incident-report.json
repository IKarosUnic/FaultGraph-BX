    "patchedPath" : "C:\\GIT HUB\\box\\target_app/PaymentServicePatched.bx",
    "fixes" : [ "NULL_CONFIG_DEREF -> Validar existencia y tipo de la seccion fallback y de cada clave, con valores por defecto seguros.", "TYPE_MISMATCH_NUMERIC -> Normalizar porcentajes y montos (quitar simbolos y separadores), validar con isNumeric() y aplicar un recargo por defecto si el valor es invalido." ],
    "ok" : true,
    "diff" : [ "-         // Cobro diferido: se encola la orden y se suma el recargo configurado.", "-         var surcharge = arguments.amount * variables.config.fallback.surchargePct;", "-         var total     = arguments.amount + surcharge;", "-         var queueName = variables.config.fallback.queueName;", "-         arrayAppend( variables.offlineQueue, { orderId: arguments.orderId, total: total, queue: queueName } );", "-         return {", "-             orderId            : arguments.orderId,", "-             status             : \"QUEUED_OFFLINE\",", "-             channel            : queueName,", "-             amount             : arguments.amount,", "-             surcharge          : surcharge,", "-             totalWithSurcharge : total,", "-             currency           : arguments.currency,", "-             cause              : arguments.cause.type", "-         };", "+         // [FaultGraph-BX] fallback endurecido sintetizado adaptativamente:", "+         //  - Regla NULL_CONFIG_DEREF: proteccion de desreferencia y valores por defecto seguros", "+         //  - Regla TYPE_MISMATCH_NUMERIC: normalizacion de porcentajes y montos", "+         var fb = ( structKeyExists( variables.config, \"fallback\" ) && isStruct( variables.config.fallback ) ) ? variables.config.fallback : {};", "+         var queueName = ( structKeyExists( fb, \"queueName\" ) && isSimpleValue( fb.queueName ) && len( trim( fb.queueName ) ) ) ? trim( fb.queueName ) : \"payments-offline-default\";", "+         var surchargeRate = 0.025;", "+         if ( structKeyExists( fb, \"surchargePct\" ) && isSimpleValue( fb.surchargePct ) ) {", "+             var rawRate = trim( toString( fb.surchargePct ) );", "+             var hasPercentSign = find( \"%\", rawRate ) > 0;", "+             rawRate = trim( replace( rawRate, \"%\", \"\", \"all\" ) );", "+             if ( isNumeric( rawRate ) ) {", "+                 surchargeRate = ( hasPercentSign || rawRate > 1 ) ? rawRate / 100 : rawRate;", "+             }", "+         }", "+         var cleanAmount = trim( replace( replace( toString( arguments.amount ), \",\", \"\", \"all\" ), \"$\", \"\", \"all\" ) );", "+         if ( !isNumeric( cleanAmount ) || cleanAmount <= 0 ) {", "+             return {", "+                 orderId            : arguments.orderId,", "+                 status             : \"REJECTED_INVALID_AMOUNT\",", "+                 channel            : \"NONE\",", "+                 amount             : 0,", "+                 surcharge          : 0,", "+                 totalWithSurcharge : 0,", "+                 currency           : arguments.currency,", "+                 cause              : arguments.cause.type", "+             };", "+         }", "+         var baseAmount = cleanAmount + 0;", "+         var surcharge  = round( baseAmount * surchargeRate * 100 ) / 100;", "+         var total      = baseAmount + surcharge;", "+         arrayAppend( variables.offlineQueue, { orderId: arguments.orderId, total: total, queue: queueName } );", "+         return {", "+             orderId            : arguments.orderId,", "+             status             : \"QUEUED_OFFLINE\",", "+             channel            : queueName,", "+             amount             : baseAmount,", "+             surcharge          : surcharge,", "+             totalWithSurcharge : total,", "+             currency           : arguments.currency,", "+             cause              : arguments.cause.type", "+         };" ],
    "changed" : true
  },
