                "reliability"       : "OFFICIAL_DOCUMENTED",
                "scope"             : "STATIC_ANALYSIS",
                "verificationLevel" : "DOCUMENTED_FACT",
                "tags"              : [ "quality", "static-analysis", "dynamic-analysis", "ast", "testing" ],
                "summary"           : "El analisis estatico detecta anomalias estructurales en microsegundos; el caos dinamico verifica el comportamiento real bajo perturbaciones.",
                "details"           : "Combinar el escaneo estatico del AST (para cadenas de configuracion desprotegidas o llamadas de reflexion) con inyecciones de caos dinamico (timeouts de lectura, payloads rotos, nulos). Las pruebas deben repetirse exactamente iguales sobre el codigo parcheado para certificar la solucion.",
                "recommendations"   : "Ejecutar comprobaciones estaticas deterministas previas y validar parches re-ejecutando la bateria completa de caos.",
                "codeSnippets"      : []
            }
        ];

        for ( var s in seeds ) {
            addEntry( s );
        }
    }

    private void function loadEcosystemKnowledge() {
        try {
            var registry = new models.language.EcosystemRegistry();
            var ecoEntries = registry.exportToKnowledgeBaseEntries();
            for ( var e in ecoEntries ) {
                try {
                    addEntry( e, false );
                } catch ( any ignore ) {}
            }
        } catch ( any ignore ) {}
    }

    /**
     * Exporta el catalogo de reglas, vulnerabilidades y remediaciones verificadas
     * a un paquete portable de vacunas (Vaccine Pack) para compartir entre microservicios.
     */
    public struct function exportVaccinePack( required string outputPath, string packName = "FaultGraph-VaccinePack" ) {
        var pack = {
            "packName"   : arguments.packName,
            "version"    : "1.0.0",
            "exportedAt" : dateTimeFormat( now(), "yyyy-MM-dd HH:mm:ss" ),
            "entryCount" : arrayLen( variables.entries ),
            "entries"    : variables.entries
        };

        var safeOut = replace( arguments.outputPath, "\", "/", "all" );
        var parentDir = getDirectoryFromPath( safeOut );
        if ( len( parentDir ) > 0 && !directoryExists( parentDir ) ) {
            directoryCreate( parentDir, true );
        }

        fileWrite( safeOut, jsonSerialize( pack ) );

        return {
            "ok"         : true,
            "packName"   : arguments.packName,
            "entryCount" : arrayLen( variables.entries ),
            "filePath"   : safeOut
        };
    }

    /**
     * Importa e inocula un paquete de vacunas externas (Vaccine Pack),
     * fusionando nuevas reglas de conocimiento e indexandolas en la memoria vectorial.
     */
    public struct function importVaccinePack( required string inputPath ) {
        var safeIn = replace( arguments.inputPath, "\", "/", "all" );
        if ( !fileExists( safeIn ) ) {
            return { "ok": false, "error": "No existe el paquete de vacunas: " & safeIn };
        }

        var content = fileRead( safeIn );
        if ( !isJson( content ) ) {
            return { "ok": false, "error": "Formato de paquete de vacunas invalido (no es JSON)" };
        }

        var pack = jsonDeserialize( content );
        var packEntries = structKeyExists( pack, "entries" ) && isArray( pack.entries ) ? pack.entries : [];
        var imported = 0;
        var skipped  = 0;

        for ( var e in packEntries ) {
            var added = addEntry( e, true );
            if ( added ) {
                imported = imported + 1;
            } else {
                skipped = skipped + 1;
            }
        }

        return {
            "ok"            : true,
            "packName"      : structKeyExists( pack, "packName" ) ? pack.packName : "ImportedPack",
            "totalInPack"   : arrayLen( packEntries ),
            "importedCount" : imported,
            "skippedCount"  : skipped
        };
    }

}

