/**
 * ShadowTester.bx - Motor de Pruebas en Sombra (Canary / Shadow Execution)
 * y Validacion de Rendimiento/Regresion Previa al Despliegue.
 *
 * Mision:
 *   Ejecuta trafico sintetico en paralelo contra la version original
 *   y la version parcheada de un servicio para garantizar que:
 *     1. La tasa de excepciones disminuye al 0%.
 *     2. No hay degradacion severa de latencia (p95/p99 dentro de tolerancia).
 *     3. Los contratos de respuesta se mantienen 100% compatibles hacia atras.
 *     4. En caso de regresion, emite de inmediato orden de ROLLBACK ATOMICO.
 *
 * 100% BoxLang nativo.
 */
class {

    property name="tolerancePct" type="numeric" default="20"; // Tolerancia maxima de degradacion de latencia (%)

    public any function init( required any config, numeric tolerancePct = 20 ) {
        variables.config       = arguments.config;
        variables.tolerancePct = arguments.tolerancePct;
        return this;
    }

    /**
     * Ejecuta una bateria de ejecucion sombra comparando dos implementaciones.
     *
     * @originalService  Instancia del servicio original
     * @candidateService Instancia del servicio parcheado candidato
     * @testPayloads     Array de payloads sinteticos representativos
     * @return struct con metricas de latencia, excepciones y recomendacion de despliegue
     */
    public struct function evaluateShadowRun(
        required any originalService,
        required any candidateService,
        array testPayloads = []
    ) {
        var t0 = getTickCount();

        // Si no se pasaron payloads, usar suite sintetica predeterminada de pagos
        var payloads = arrayLen( arguments.testPayloads ) > 0 ? arguments.testPayloads : getDefaultPayloads();

        var origStats = {
            "totalRequests" : arrayLen( payloads ),
            "successCount"  : 0,
            "errorCount"    : 0,
            "latencies"     : [],
            "errors"        : []
        };

        var candStats = {
            "totalRequests" : arrayLen( payloads ),
            "successCount"  : 0,
            "errorCount"    : 0,
            "latencies"     : [],
            "errors"        : []
        };

        for ( var p in payloads ) {
            // 1. Ejecucion en el servicio original
            var reqT0 = getTickCount();
            try {
                var resOrig = invokeService( arguments.originalService, p );
                arrayAppend( origStats.latencies, getTickCount() - reqT0 );
                origStats.successCount++;
            } catch ( any eOrig ) {
                arrayAppend( origStats.latencies, getTickCount() - reqT0 );
                origStats.errorCount++;
                arrayAppend( origStats.errors, { "payload": p, "type": eOrig.type, "message": eOrig.message } );
            }

            // 2. Ejecucion en el servicio candidato parcheado
            var reqT1 = getTickCount();
            try {
                var resCand = invokeService( arguments.candidateService, p );
                arrayAppend( candStats.latencies, getTickCount() - reqT1 );
                candStats.successCount++;
            } catch ( any eCand ) {
                arrayAppend( candStats.latencies, getTickCount() - reqT1 );
                candStats.errorCount++;
                arrayAppend( candStats.errors, { "payload": p, "type": eCand.type, "message": eCand.message } );
            }
        }

        // Calcular metricas de resumen
        var origAvgLat = calculateAvg( origStats.latencies );
        var candAvgLat = calculateAvg( candStats.latencies );

        var origErrorRate = origStats.totalRequests > 0 ? ( origStats.errorCount / origStats.totalRequests ) * 100 : 0;
        var candErrorRate = candStats.totalRequests > 0 ? ( candStats.errorCount / candStats.totalRequests ) * 100 : 0;

        // Comprobar regresion
        var regressionDetected = false;
        var decision = "APPROVED_FOR_RELEASE";
        var rationale = [];

        // Condicion 1: La tasa de error del candidato debe ser menor o igual a la original
        if ( candErrorRate > origErrorRate ) {
            regressionDetected = true;
            decision = "REJECTED_REGRESSION_DETECTED";
            arrayAppend( rationale, "La tasa de errores aumento del " & origErrorRate & "% al " & candErrorRate & "%." );
        }

        // Condicion 2: El candidato soluciono errores reales
        if ( origErrorRate > 0 && candErrorRate == 0 ) {
            arrayAppend( rationale, "El candidato elimino el 100% de las excepciones (" & origStats.errorCount & " errores mitigados)." );
        }

        // Condicion 3: Verificacion de latencia dentro de tolerancia
        var latencyDiffPct = 0;
        if ( origAvgLat > 0 ) {
            latencyDiffPct = ( ( candAvgLat - origAvgLat ) / origAvgLat ) * 100;
            if ( latencyDiffPct > variables.tolerancePct ) {
                arrayAppend( rationale, "Advertencia: incremento de latencia del " & round( latencyDiffPct ) & "% (limite: " & variables.tolerancePct & "%)." );
                if ( candErrorRate == 0 && origErrorRate > 0 ) {
                    // Si resolvio caidas criticas, la penalizacion de latencia se acepta con advertencia
                    decision = "APPROVED_WITH_LATENCY_WARNING";
                } else {
                    decision = "REJECTED_LATENCY_DEGRADATION";
                    regressionDetected = true;
                }
            } else {
                arrayAppend( rationale, "Latencia dentro de la tolerancia permitida (" & round( latencyDiffPct ) & "% vs original)." );
            }
        }

        return {
            "decision"           : decision,
            "regressionDetected" : regressionDetected,
            "safeToDeploy"       : !regressionDetected,
            "durationMs"         : getTickCount() - t0,
            "original"           : {
                "errorRatePct" : origErrorRate,
                "errorCount"   : origStats.errorCount,
                "avgLatencyMs" : origAvgLat
            },
            "candidate"          : {
                "errorRatePct" : candErrorRate,
                "errorCount"   : candStats.errorCount,
                "avgLatencyMs" : candAvgLat
            },
            "rationale"          : rationale
        };
    }

    /**
     * Genera un conjunto de casos de prueba representativos para shadow testing.
     */
    public array function getDefaultPayloads() {
        return [
            // Transaccion normal valida
            { "amount": 100.0, "currency": "USD", "channel": "ONLINE", "customer": { "id": "CUST-01" } },
            // Monto como cadena con porcentaje (falla tipica de casteo)
            { "amount": "250.50", "currency": "USD", "channel": "FALLBACK", "customer": { "id": "CUST-02" } },
            // Monto flotante grande
            { "amount": 5420.75, "currency": "EUR", "channel": "ONLINE", "customer": { "id": "CUST-03" } },
            // Monto con formato no estandar
            { "amount": "1,200.00", "currency": "USD", "channel": "FALLBACK", "customer": { "id": "CUST-04" } },
            // Cero y valores limites
            { "amount": 0.01, "currency": "USD", "channel": "ONLINE", "customer": { "id": "CUST-05" } }
        ];
    }

    private numeric function calculateAvg( required array latencies ) {
        if ( arrayLen( arguments.latencies ) == 0 ) { return 0; }
        var sum = 0;
        for ( var lat in arguments.latencies ) {
            sum += lat;
        }
        return round( ( sum / arrayLen( arguments.latencies ) ) * 100 ) / 100;
    }

    private any function invokeService( required any service, required struct payload ) {
        if ( isCustomFunction( arguments.service ) || isClosure( arguments.service ) ) {
            return arguments.service( arguments.payload );
        } else if ( isObject( arguments.service ) || isStruct( arguments.service ) ) {
            if ( structKeyExists( arguments.service, "processPayment" ) ) {
                return arguments.service.processPayment( arguments.payload );
            } else if ( structKeyExists( arguments.service, "charge" ) ) {
                var orderId = "ORD-" & left( hash( toString( arguments.payload ) ), 8 );
                var amt = structKeyExists( arguments.payload, "amount" ) ? arguments.payload.amount : 100;
                var curr = structKeyExists( arguments.payload, "currency" ) ? arguments.payload.currency : "USD";
                return arguments.service.charge( orderId, amt, curr );
            } else if ( structKeyExists( arguments.service, "execute" ) ) {
                return arguments.service.execute( arguments.payload );
            }
        }
        throw( type="InvocationException", message="El servicio no implementa una interfaz ejecutable conocida (processPayment, charge, execute)." );
    }

}
