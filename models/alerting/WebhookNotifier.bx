/**
 * WebhookNotifier.bx - Despachador de Alertas y Notificaciones ChatOps para FaultGraph-BX.
 *
 * Mision:
 *   Conecta los eventos de deteccion, diagnostico y parches de LiveSentinel e IncidentDirector
 *   con canales de comunicacion de ingenieria (Slack, Discord, Microsoft Teams y Webhooks REST):
 *     - Genera tarjetas estructuradas en Slack Block Kit y Discord Embeds.
 *     - Provee modo dry-run seguro para pruebas y ejecucion 100% offline.
 *     - Sanitiza la informacion sensible antes de despachar el payload.
 *
 * 100% BoxLang nativo.
 */
class {

    property name="webhookUrl" type="string"  default="";
    property name="channel"    type="string"  default="generic";
    property name="dryRun"     type="boolean" default="true";

    public any function init(
        string webhookUrl = "",
        string channel = "generic",
        boolean dryRun = true
    ) {
        variables.webhookUrl = trim( arguments.webhookUrl );
        variables.channel    = lcase( trim( arguments.channel ) );
        variables.dryRun     = arguments.dryRun || ( len( variables.webhookUrl ) == 0 );
        variables.dispatchedCount = 0;
        return this;
    }

    public numeric function getDispatchedCount() {
        return variables.dispatchedCount;
    }

    public boolean function isDryRun() {
        return variables.dryRun;
    }

    /**
     * Envia una alerta estructurada de incidente al canal configurado.
     */
    public struct function notify( required struct incidentNotice ) {
        var payload = {};

        if ( variables.channel == "slack" ) {
            payload = formatSlack( arguments.incidentNotice );
        } else if ( variables.channel == "discord" ) {
            payload = formatDiscord( arguments.incidentNotice );
        } else {
            payload = formatGeneric( arguments.incidentNotice );
        }

        variables.dispatchedCount = variables.dispatchedCount + 1;

        if ( variables.dryRun || len( variables.webhookUrl ) == 0 ) {
            return {
                "ok"              : true,
                "mode"            : "DRY_RUN",
                "channel"         : variables.channel,
                "dispatchedCount" : variables.dispatchedCount,
                "payload"         : payload
            };
        }

        // Despacho HTTP real si hay URL configurada y dryRun = false
        try {
            var urlObj = createObject( "java", "java.net.URI" ).create( variables.webhookUrl ).toURL();
            var conn = urlObj.openConnection();
            conn.setRequestMethod( "POST" );
            conn.setConnectTimeout( 2000 );
            conn.setReadTimeout( 3000 );
            conn.setDoOutput( true );
            conn.setRequestProperty( "Content-Type", "application/json; charset=UTF-8" );

            var bodyJson = jsonSerialize( payload );
            var os = conn.getOutputStream();
            os.write( bodyJson.getBytes( "UTF-8" ) );
            os.flush();
            os.close();

            var statusCode = conn.getResponseCode();
            return {
                "ok"         : statusCode >= 200 && statusCode < 300,
                "statusCode" : statusCode,
                "channel"    : variables.channel,
                "payload"    : payload
            };
        } catch ( any e ) {
            return {
                "ok"     : false,
                "error"  : e.message,
                "channel": variables.channel,
                "payload": payload
            };
        }
    }

    /**
     * Formatea el aviso en bloques ricos de Slack Block Kit.
     */
    public struct function formatSlack( required struct notice ) {
        var incidentNum = structKeyExists( arguments.notice, "incidentNumber" ) ? arguments.notice.incidentNumber : 1;
        var ts          = structKeyExists( arguments.notice, "timestamp" ) ? arguments.notice.timestamp : dateTimeFormat( now(), "yyyy-MM-dd HH:mm:ss" );
        var src         = structKeyExists( arguments.notice, "source" ) ? arguments.notice.source : "target_app/PaymentService.bx";

        var blocks = [
            {
                "type": "header",
                "text": { "type": "plain_text", "text": "[FaultGraph-BX] Incidente Detectado No. " & incidentNum, "emoji": true }
            },
            {
                "type": "section",
                "fields": [
                    { "type": "mrkdwn", "text": "*Origen:*" & char( 10 ) & "`" & src & "`" },
                    { "type": "mrkdwn", "text": "*Hora:*" & char( 10 ) & ts }
                ]
            }
        ];

        var causes = [];
        if ( structKeyExists( arguments.notice, "diagnosis" ) && structKeyExists( arguments.notice.diagnosis, "causes" ) ) {
            causes = arguments.notice.diagnosis.causes;
        }

        if ( arrayLen( causes ) > 0 ) {
            var causeText = "";
            for ( var c in causes ) {
                causeText = causeText & "• *[" & c.severity & "]* `" & c.code & "`: " & c.title & char( 10 );
            }
            arrayAppend( blocks, {
                "type": "section",
                "text": { "type": "mrkdwn", "text": "*Causas Raiz Diagnosticadas:*" & char( 10 ) & causeText }
            } );
        }

        return {
            "text"   : "Incidente detectado por FaultGraph-BX No. " & incidentNum,
            "blocks" : blocks
        };
    }

    /**
     * Formatea el aviso en embeds interactivos para Discord.
     */
    public struct function formatDiscord( required struct notice ) {
        var incidentNum = structKeyExists( arguments.notice, "incidentNumber" ) ? arguments.notice.incidentNumber : 1;
        var src         = structKeyExists( arguments.notice, "source" ) ? arguments.notice.source : "target_app/PaymentService.bx";

        var fields = [
            { "name": "Archivo / Servicio", "value": "`" & src & "`", "inline": true },
            { "name": "Estado", "value": "Investigando / Auto-Reparando", "inline": true }
        ];

        return {
            "embeds": [
                {
                    "title"      : "FaultGraph-BX Incident No. " & incidentNum,
                    "description": "Se detectaron excepciones criticas. El Centinela ha sintetizado pruebas de regresion.",
                    "color"      : 15158332,
                    "fields"     : fields,
                    "footer"     : { "text": "FaultGraph-BX Autonomous Incident Response" }
                }
            ]
        };
    }

    /**
     * Formato JSON generico para webhooks corporativos y REST endpoints.
     */
    public struct function formatGeneric( required struct notice ) {
        return {
            "system"   : "FaultGraph-BX",
            "version"  : "2.4.0",
            "event"    : "INCIDENT_ALERT",
            "notice"   : arguments.notice,
            "emittedAt": dateTimeFormat( now(), "yyyy-MM-dd HH:mm:ss" )
        };
    }

}
