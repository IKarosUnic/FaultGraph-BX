/**
 * CanaryRollbackManager.bx - Gestor de Despliegue Canary y Auto-Reversion Atomica (Rollback) para BoxLang.
 *
 * Mision:
 *   Garantiza que ningun parche promovido en caliente genere efectos colaterales adversos
 *   o degradacion no prevista en trafico real de produccion:
 *     1. Observacion Canary: vigila una ventana de transacciones/tiempo post-promocion.
 *     2. Evaluacion de SLA & Presupuesto de Error: monitoriza errores y latencia (p95/p99).
 *     3. Auto-Rollback Autonomo: ante violacion de SLA o error en el fallback,
 *        revierte atomicamente el codigo fuente (.bx) a su version de respaldo (.bak),
 *        invalida la cache y despacha alertas de panico via Webhook y EventBus.
 *     4. Promocion Definitiva: confirma la estabilidad cuando la ventana concluye con 0 fallos.
 *
 * 100% BoxLang nativo.
 */
class {

    property name="targetPath"       type="string"  default="";
    property name="backupPath"       type="string"  default="";
    property name="state"            type="string"  default="IDLE"; // IDLE, CANARY_ACTIVE, ROLLBACK_TRIGGERED, PROMOTION_CONFIRMED
    property name="errorBudget"      type="numeric" default="0";
    property name="latencySlaMs"     type="numeric" default="500";

    public any function init( any config = null, any eventBus = null, any notifier = null ) {
        variables.config        = arguments.config;
        variables.eventBus      = !isNull( arguments.eventBus ) ? arguments.eventBus : new models.EventBus();
        variables.notifier      = !isNull( arguments.notifier ) ? arguments.notifier : new models.alerting.WebhookNotifier( dryRun = true );

        variables.lock          = createObject( "java", "java.util.concurrent.locks.ReentrantLock" ).init();
        variables.state         = "IDLE";
        variables.targetPath    = "";
        variables.backupPath    = "";
        variables.errorBudget   = 0;
        variables.latencySlaMs  = 500;
        variables.history       = [];

        variables.metrics = {
            "observedCalls"    : 0,
            "successfulCalls"  : 0,
            "failedCalls"      : 0,
            "slaViolations"    : 0,
            "rollbackCount"    : 0,
            "startTime"        : "",
            "endTime"          : "",
            "rollbackReason"   : ""
        };

        return this;
    }

    public string function getState() {
        variables.lock.lock();
        try {
            return variables.state;
        } finally {
            variables.lock.unlock();
        }
    }

    public struct function getMetrics() {
        variables.lock.lock();
        try {
            var m = duplicate( variables.metrics );
            m[ "state" ] = variables.state;
            m[ "targetPath" ] = variables.targetPath;
            m[ "backupPath" ] = variables.backupPath;
            return m;
        } finally {
            variables.lock.unlock();
        }
    }

    /**
     * Inicia una ventana de observacion Canary para el archivo objetivo.
     */
    public struct function startCanary( required string targetPath, string backupPath = "", struct options = {} ) {
        variables.lock.lock();
        try {
            variables.targetPath = arguments.targetPath;
            if ( len( trim( arguments.backupPath ) ) > 0 ) {
                variables.backupPath = arguments.backupPath;
            } else {
                variables.backupPath = arguments.targetPath & ".bak";
            }

            if ( structKeyExists( arguments.options, "errorBudget" ) ) {
                variables.errorBudget = val( arguments.options.errorBudget );
            }
            if ( structKeyExists( arguments.options, "latencySlaMs" ) ) {
                variables.latencySlaMs = val( arguments.options.latencySlaMs );
            }

            // Asegurar que exista respaldo antes de iniciar el Canary
            if ( !fileExists( variables.backupPath ) && fileExists( variables.targetPath ) ) {
                fileWrite( variables.backupPath, fileRead( variables.targetPath ) );
            }

            variables.state = "CANARY_ACTIVE";
            variables.history = [];
            variables.metrics.observedCalls   = 0;
            variables.metrics.successfulCalls = 0;
            variables.metrics.failedCalls     = 0;
            variables.metrics.slaViolations   = 0;
            variables.metrics.rollbackCount   = 0;
            variables.metrics.startTime       = dateTimeFormat( now(), "yyyy-MM-dd HH:mm:ss" );
            variables.metrics.endTime         = "";
            variables.metrics.rollbackReason  = "";

            variables.eventBus.emit( "onCanaryStarted", {
                "targetPath"  : variables.targetPath,
                "backupPath"  : variables.backupPath,
                "errorBudget" : variables.errorBudget,
                "latencySlaMs": variables.latencySlaMs
            } );

            return {
                "ok"        : true,
                "state"     : variables.state,
                "targetPath": variables.targetPath,
                "backupPath": variables.backupPath
            };
        } finally {
            variables.lock.unlock();
        }
    }

    /**
     * Registra el resultado de una transaccion durante el periodo Canary.
     * Si se supera el presupuesto de error o SLA, dispara automaticamente el Rollback.
     */
    public struct function recordTransaction( required boolean success, string errorMsg = "", numeric latencyMs = 0 ) {
        variables.lock.lock();
        try {
            if ( variables.state != "CANARY_ACTIVE" ) {
                return {
                    "ok"                : false,
                    "state"             : variables.state,
                    "rollbackTriggered" : false,
                    "message"           : "Canary no esta activo (estado: " & variables.state & ")"
                };
            }

            variables.metrics.observedCalls = variables.metrics.observedCalls + 1;

            if ( arguments.success ) {
                variables.metrics.successfulCalls = variables.metrics.successfulCalls + 1;
            } else {
                variables.metrics.failedCalls = variables.metrics.failedCalls + 1;
            }

            var isSlaBreached = ( arguments.latencyMs > variables.latencySlaMs );
            if ( isSlaBreached ) {
                variables.metrics.slaViolations = variables.metrics.slaViolations + 1;
            }

            var entry = {
                "timestamp" : dateTimeFormat( now(), "yyyy-MM-dd HH:mm:ss" ),
                "success"   : arguments.success,
                "error"     : arguments.errorMsg,
                "latencyMs" : arguments.latencyMs,
                "slaBreach" : isSlaBreached
            };
            arrayAppend( variables.history, entry );

            var rollbackTriggered = false;
            // Evaluacion de gatillo de Rollback
            if ( variables.metrics.failedCalls > variables.errorBudget ) {
                var reason = "Presupuesto de error superado: " & variables.metrics.failedCalls & " fallos (limite: " & variables.errorBudget & "). Ultimo error: " & arguments.errorMsg;
                executeRollback( reason );
                rollbackTriggered = true;
            }

            return {
                "ok"                : true,
                "state"             : variables.state,
                "rollbackTriggered" : rollbackTriggered,
                "observedCalls"     : variables.metrics.observedCalls,
                "failedCalls"       : variables.metrics.failedCalls,
                "slaViolations"     : variables.metrics.slaViolations
            };
        } finally {
            variables.lock.unlock();
        }
    }

    /**
     * Ejecuta la reversion atomica (Rollback) hacia la copia .bak original.
     */
    public struct function executeRollback( required string reason ) {
        // Asume que la llamada puede venir desde fuera o internamente con el lock ya tomado
        var mustLock = !variables.lock.isHeldByCurrentThread();
        if ( mustLock ) {
            variables.lock.lock();
        }
        try {
            var restored = false;
            var restoreError = "";

            if ( len( variables.backupPath ) > 0 && fileExists( variables.backupPath ) && len( variables.targetPath ) > 0 ) {
                try {
                    var backupContent = fileRead( variables.backupPath );
                    fileWrite( variables.targetPath, backupContent );
                    restored = true;
                } catch ( any ioErr ) {
                    restoreError = ioErr.message;
                }
            } else {
                restoreError = "Archivo de respaldo no encontrado en: " & variables.backupPath;
            }

            variables.state = "ROLLBACK_TRIGGERED";
            variables.metrics.rollbackCount  = variables.metrics.rollbackCount + 1;
            variables.metrics.rollbackReason = arguments.reason;
            variables.metrics.endTime        = dateTimeFormat( now(), "yyyy-MM-dd HH:mm:ss" );

            var notice = {
                "event"         : "EMERGENCY_ROLLBACK",
                "severity"      : "CRITICAL",
                "reason"        : arguments.reason,
                "targetPath"    : variables.targetPath,
                "backupPath"    : variables.backupPath,
                "restored"      : restored,
                "restoreError"  : restoreError,
                "metrics"       : duplicate( variables.metrics ),
                "timestamp"     : variables.metrics.endTime
            };

            // Notificacion via EventBus
            variables.eventBus.emit( "onCanaryRollback", notice );

            // Notificacion via Webhook ChatOps
            try {
                variables.notifier.notify( {
                    "appName"     : "FaultGraph-BX",
                    "severity"    : "CRITICAL",
                    "source"      : variables.targetPath,
                    "causes"      : [ { "code": "CANARY_BREACH", "severity": "CRITICAL", "title": "Auto-Rollback Ejecutado", "sampleError": arguments.reason } ],
                    "timestamp"   : variables.metrics.endTime,
                    "description" : "Reversion atomica inmediata activada por degradacion canary en produccion."
                } );
            } catch ( any ignore ) {}

            return {
                "ok"          : restored,
                "rolledBack"  : true,
                "reason"      : arguments.reason,
                "restoredPath": variables.targetPath,
                "backupPath"  : variables.backupPath,
                "timestamp"   : variables.metrics.endTime
            };
        } finally {
            if ( mustLock ) {
                variables.lock.unlock();
            }
        }
    }

    /**
     * Confirma exitosamente el despliegue Canary y promueve a 100% de produccion.
     */
    public struct function confirmPromotion() {
        variables.lock.lock();
        try {
            if ( variables.state != "CANARY_ACTIVE" ) {
                return {
                    "ok"     : false,
                    "state"  : variables.state,
                    "message": "No se puede confirmar promocion desde estado " & variables.state
                };
            }

            variables.state = "PROMOTION_CONFIRMED";
            variables.metrics.endTime = dateTimeFormat( now(), "yyyy-MM-dd HH:mm:ss" );

            var confirmNotice = {
                "event"         : "CANARY_CONFIRMED",
                "severity"      : "INFO",
                "targetPath"    : variables.targetPath,
                "observedCalls" : variables.metrics.observedCalls,
                "successCalls"  : variables.metrics.successfulCalls,
                "timestamp"     : variables.metrics.endTime
            };

            variables.eventBus.emit( "onCanaryPromoted", confirmNotice );

            try {
                variables.notifier.notify( {
                    "appName"     : "FaultGraph-BX",
                    "severity"    : "INFO",
                    "source"      : variables.targetPath,
                    "causes"      : [],
                    "timestamp"   : variables.metrics.endTime,
                    "description" : "Canary supero 100% de la ventana de observacion con 0 incidentes. Parche confirmado en produccion."
                } );
            } catch ( any ignore ) {}

            return {
                "ok"       : true,
                "promoted" : true,
                "state"    : variables.state,
                "metrics"  : duplicate( variables.metrics )
            };
        } finally {
            variables.lock.unlock();
        }
    }

    /**
     * Ejecuta una bateria de transacciones sinteticas para verificar la salud Canary.
     */
    public struct function runCanarySimulation( required any serviceInstance, array probeRequests = [] ) {
        if ( arrayLen( arguments.probeRequests ) == 0 ) {
            // Generar 5 transacciones de prueba (3 sanas, 2 con contingencia)
            arguments.probeRequests = [
                { "orderId": "CANARY-01", "amount": 100.00, "currency": "USD" },
                { "orderId": "CANARY-02", "amount": 49.99,  "currency": "USD" },
                { "orderId": "CANARY-03", "amount": 15.50,  "currency": "USD" },
                { "orderId": "CANARY-04", "amount": 250.00, "currency": "USD" },
                { "orderId": "CANARY-05", "amount": 89.10,  "currency": "USD" }
            ];
        }

        var results = [];
        for ( var req in arguments.probeRequests ) {
            var t0 = getTickCount();
            var success = false;
            var err = "";
            try {
                var res = arguments.serviceInstance.charge( req.orderId, req.amount, req.currency );
                success = isStruct( res ) && structKeyExists( res, "status" ) && ( res.status == "APPROVED" || res.status == "QUEUED_OFFLINE" );
                if ( !success ) {
                    err = "Respuesta de cobro inesperada: " & jsonSerialize( res );
                }
            } catch ( any e ) {
                success = false;
                err = e.message;
            }
            var lat = getTickCount() - t0;
            var rec = recordTransaction( success, err, lat );
            arrayAppend( results, { "orderId": req.orderId, "success": success, "error": err, "latencyMs": lat, "record": rec } );

            if ( rec.rollbackTriggered ) {
                break;
            }
        }

        if ( variables.state == "CANARY_ACTIVE" && variables.metrics.failedCalls == 0 ) {
            confirmPromotion();
        }

        return {
            "ok"               : ( variables.state == "PROMOTION_CONFIRMED" ),
            "state"            : variables.state,
            "processedCount"   : arrayLen( results ),
            "results"          : results,
            "metrics"          : getMetrics()
        };
    }

    public void function reset() {
        variables.lock.lock();
        try {
            variables.state = "IDLE";
            variables.targetPath = "";
            variables.backupPath = "";
            variables.history = [];
            variables.metrics = {
                "observedCalls"    : 0,
                "successfulCalls"  : 0,
                "failedCalls"      : 0,
                "slaViolations"    : 0,
                "rollbackCount"    : 0,
                "startTime"        : "",
                "endTime"          : "",
                "rollbackReason"   : ""
            };
        } finally {
            variables.lock.unlock();
        }
    }

}
