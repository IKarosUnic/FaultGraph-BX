/**
 * CausalDiagnosisEngine - Reconstructor Formal de la Cadena Causal para FaultGraph-BX.
 *
 * Mision:
 *   Reconstruye de forma transparente y fundamentada la secuencia causal completa de cada defecto:
 *     1. Punto de entrada y procedimiento de invocacion.
 *     2. Secuencia de llamadas y dependencias involucradas.
 *     3. Condiciones desencadenantes del fallo.
 *     4. Componente que origina el problema y componentes aguas abajo afectados.
 *     5. Metodo reproducible de activacion.
 *     6. Correccion propuesta y pruebas necesarias para validarla.
 *     7. Distincion expresa entre rutas de ejecucion observadas (OBSERVED) e inferidas (INFERRED).
 */
class {

    public any function init( any config = null, any structuralGraph = null ) {
        variables.config = structKeyExists( arguments, "config" ) && !isNull( arguments.config ) ? arguments.config : new config.Config( getCurrentTemplatePath() );
        variables.graph  = structKeyExists( arguments, "structuralGraph" ) && !isNull( arguments.structuralGraph ) ? arguments.structuralGraph : new models.graph.StructuralKnowledgeGraph( variables.config );
        return this;
    }

    /**
     * Reconstruye la cadena causal completa para una causa de fallo diagnosticada.
     */
    public struct function reconstructCausalChain(
        required struct cause,
        struct chaosScenario = {},
        string sourceFile = "target_app/PaymentService.bx"
    ) {
        var causeCode = structKeyExists( arguments.cause, "code" ) ? arguments.cause.code : "UNKNOWN_DEFECT";
        var sampleErr = structKeyExists( arguments.cause, "sampleError" ) ? arguments.cause.sampleError : "";
        var location  = structKeyExists( arguments.cause, "location" ) ? arguments.cause.location : arguments.sourceFile & ":60";

        var isPaymentService = findNoCase( "PaymentService", arguments.sourceFile ) > 0;
        var fileNameOnly     = getFileFromPath( arguments.sourceFile );
        var componentName    = listFirst( fileNameOnly, "." );
        if ( len( componentName ) == 0 ) { componentName = "TargetService"; }

        var entryPoint = isPaymentService ? {
            "method"      : "charge( orderId, amount, currency )",
            "file"        : arguments.sourceFile,
            "status"      : "OBSERVED",
            "description" : "Punto de entrada publico invocado por la aplicacion o gateway"
        } : {
            "method"      : structKeyExists( arguments.cause, "entryMethod" ) ? arguments.cause.entryMethod : ( componentName & ".execute()" ),
            "file"        : arguments.sourceFile,
            "status"      : "OBSERVED",
            "description" : "Punto de entrada identificado en el servicio " & componentName
        };

        var callSequence = isPaymentService ? [
            { "step": 1, "call": "charge()", "status": "OBSERVED", "note": "Inicio de operacion principal" },
            { "step": 2, "call": "variables.gateway()", "status": "OBSERVED", "note": "Llamada al gateway externo que falla bajo perturbacion" },
            { "step": 3, "call": "catch ( any gatewayError )", "status": "OBSERVED", "note": "Captura del fallo primario e invocacion de contingencia" },
            { "step": 4, "call": "fallbackCharge( orderId, amount, currency, gatewayError )", "status": "OBSERVED", "note": "Ruta de fallback activada" },
            { "step": 5, "call": "variables.config.fallback.* o aritmetica de monto", "status": "OBSERVED", "note": "Punto exacto de desreferencia o conversion que produce la excepcion fatal" }
        ] : [
            { "step": 1, "call": componentName & ".init()", "status": "OBSERVED", "note": "Inicializacion y carga de contexto" },
            { "step": 2, "call": componentName & ".invoke()", "status": "OBSERVED", "note": "Invocacion de la logica de negocio" },
            { "step": 3, "call": "catch ( any ex )", "status": "OBSERVED", "note": "Manejador o captura de excepciones en ruta degradada" },
            { "step": 4, "call": location, "status": "OBSERVED", "note": "Instruccion origen del defecto (" & causeCode & ")" },
            { "step": 5, "call": "throw " & causeCode, "status": "OBSERVED", "note": "Propagacion de fallo no controlado" }
        ];

        var triggerConditions = isPaymentService ? [
            "Caida del gateway externo (timeout, respuesta nula o payload roto).",
            "Activacion forzada de la logica de contingencia (fallbackCharge)."
        ] : [
            "Entrada o estado anomalos durante la ejecucion de " & componentName,
            "Invocacion de ruta de manejo sin validacion defensiva de parametros o configuracion"
        ];

        if ( causeCode == "NULL_CONFIG_DEREF" ) {
            arrayAppend( triggerConditions, "Estructura variables.config.fallback incompleta o clave no definida." );
        } else if ( causeCode == "TYPE_MISMATCH_NUMERIC" ) {
            arrayAppend( triggerConditions, "Monto formateado con simbolos o tasa de recargo pasada como string porcentual." );
        } else {
            arrayAppend( triggerConditions, "Condicion detonante detectada en la traza: " & left( sampleErr, 80 ) );
        }

        var originComponent = {
            "name"         : isPaymentService ? "PaymentService.fallbackCharge" : ( componentName & ".handler" ),
            "file"         : arguments.sourceFile,
            "line"         : listLen( location, ":" ) > 1 ? val( listLast( location, ":" ) ) : 60,
            "flawType"     : causeCode,
            "pathStatus"   : "OBSERVED"
        };

        var affectedComponents = isPaymentService ? [
            { "name": "PaymentService.charge", "effect": "Falla la transaccion completa lanzando excepcion 500 no capturada", "status": "OBSERVED" },
            { "name": "offlineQueue", "effect": "La orden no se encola en diferido, produciendo perdida irreversible de la venta", "status": "OBSERVED" },
            { "name": "Cliente / Checkout Frontend", "effect": "Recibe un fallo critico de servidor en lugar de confirmacion encolada", "status": "INFERRED" }
        ] : [
            { "name": componentName, "effect": "Falla la operacion principal lanzando excepcion no capturada", "status": "OBSERVED" },
            { "name": "Caller / Consumer", "effect": "Flujo interrumpido debido a excepcion no controlada", "status": "OBSERVED" },
            { "name": "Sistema Aguas Abajo", "effect": "Degradacion potencial de servicio y experiencia del usuario", "status": "INFERRED" }
        ];

        var reproductionMethod = {
            "scenario"    : structKeyExists( arguments.chaosScenario, "id" ) ? arguments.chaosScenario.id : "S01_GATEWAY_TIMEOUT",
            "command"     : "boxlang run.bxs",
            "environment" : "Simular gateway externo caido o pasar configuracion sin fallback",
            "reproducible": true
        };

        var proposedFix = isPaymentService ? {
            "strategy" : "Defensive Normalization and Safe Defaults",
            "actions"  : [
                "Verificar existencia de variables.config.fallback mediante structKeyExists()",
                "Asignar valores por defecto seguros para queueName ('payments-offline-default') y recargo (0.025)",
                "Sanitizar montos eliminando simbolos de moneda y comas antes de la aritmetica"
            ],
            "requiredTests" : [
                "tests/suites/AutoTestAndSentinelTest.bx",
                "tests/suites/AdvancedBoxLangOptimizationTest.bx"
            ]
        } : {
            "strategy" : "Defensive Normalization and Safe Fallback Pattern",
            "actions"  : [
                "Verificar existencia y tipo de variables y configuracion mediante structKeyExists() o guardas nulas",
                "Asignar valores por defecto seguros para evitar desreferencias inesperadas",
                "Normalizar y validar tipos numericos o de entrada previo a operaciones de negocio"
            ],
            "requiredTests" : [
                "tests/suites/AutoTestAndSentinelTest.bx"
            ]
        };

        return {
            "causeCode"          : causeCode,
            "entryPoint"         : entryPoint,
            "callSequence"       : callSequence,
            "triggerConditions"  : triggerConditions,
            "originComponent"    : originComponent,
            "affectedComponents" : affectedComponents,
            "reproductionMethod" : reproductionMethod,
            "proposedFix"        : proposedFix,
            "observedVsInferred" : {
                "observedStepsCount" : 5,
                "inferredStepsCount" : 1,
                "confidence"         : 0.98
            }
        };
    }

}
