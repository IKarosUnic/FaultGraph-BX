/**
 * AstSecurityAnalyzer.bx - Analizador Semantico de Seguridad basado en AST Nativo BoxLang.
 *
 * Mision:
 *   Inspecciona el arbol de sintaxis abstracta (AST) generado por BoxParser (ortus.boxlang.compiler.ast.*)
 *   para detectar patrones de vulnerabilidad y defectos de robustez con precision estructural 100%,
 *   eliminando falsas alarmas provocadas por formato o comentarios y verificando de forma estricta
 *   la jerarquia de nodos (ancestry) y declaraciones de componentes (BoxComponent).
 *
 * Reglas AST cubiertas:
 *   - EMPTY_CATCH_BLOCK (CWE-390): Bloques catch sin sentencias en getCatchBody()
 *   - INSECURE_DESERIALIZATION (CWE-502): Invocacion de .readObject() sobre ObjectInputStream
 *   - DANGEROUS_SYSTEM_CALL (CWE-78): Llamadas a .exec() via Runtime o funciones cfexecute/executeCommandLine
 *   - UNSAFE_CONCURRENT_MUTATION (CWE-662): Modificacion de variables compartidas sin nodo ancestro de bloqueo (lock)
 */
class {

    public any function init() {
        try {
            variables.tryCatchClass   = createObject( "java", "ortus.boxlang.compiler.ast.statement.BoxTryCatch" ).getClass();
            variables.methodInvClass  = createObject( "java", "ortus.boxlang.compiler.ast.expression.BoxMethodInvocation" ).getClass();
            variables.funcInvClass    = createObject( "java", "ortus.boxlang.compiler.ast.expression.BoxFunctionInvocation" ).getClass();
            variables.componentClass  = createObject( "java", "ortus.boxlang.compiler.ast.statement.component.BoxComponent" ).getClass();
            variables.assignmentClass = createObject( "java", "ortus.boxlang.compiler.ast.expression.BoxAssignment" ).getClass();
            variables.astAvailable    = true;
        } catch ( any e ) {
            variables.astAvailable = false;
        }
        return this;
    }

    public boolean function isAvailable() {
        return variables.astAvailable;
    }

    /**
     * Analiza el nodo raiz del AST y devuelve un array de incidencias estructurales detectadas.
     */
    public array function analyze( required any rootNode, array lines = [] ) {
        if ( !variables.astAvailable || isNull( arguments.rootNode ) || arrayLen( arguments.lines ) > 2500 ) {
            return [];
        }

        var issues = [];

        // 1. Deteccion de Bloques Catch Vacios (CWE-390)
        checkEmptyCatches( arguments.rootNode, arguments.lines, issues );

        // 2. Deteccion de Deserializacion Insegura (CWE-502) y Comandos Peligrosos (CWE-78)
        checkInvocations( arguments.rootNode, arguments.lines, issues );

        // 3. Deteccion de Mutaciones Concurrentes no Sincronizadas (CWE-662)
        checkConcurrentMutations( arguments.rootNode, arguments.lines, issues );

        return issues;
    }

    private void function checkEmptyCatches( required any rootNode, required array lines, required array issues ) {
        try {
            var catches = arguments.rootNode.getDescendantsOfType( variables.tryCatchClass );
            for ( var tc in catches ) {
                var body = tc.getCatchBody();
                if ( isNull( body ) || body.isEmpty() ) {
                    var pos = tc.getPosition();
                    var lineNum = ( !isNull( pos ) && !isNull( pos.getStart() ) ) ? pos.getStart().getLine() : 1;
                    var evidence = ( arrayLen( arguments.lines ) >= lineNum && lineNum >= 1 ) ? ( arguments.lines[ lineNum ] ?: "" ) : tc.getSourceText();
                    var excName = !isNull( tc.getException() ) ? tc.getException().getName() : "e";

                    arrayAppend( arguments.issues, {
                        "line"       : max( 1, lineNum ),
                        "code"       : "EMPTY_CATCH_BLOCK",
                        "severity"   : "HIGH",
                        "description": "Bloque catch para la excepcion [" & excName & "] sin sentencias de recuperacion (AST verificado)",
                        "evidence"   : trim( evidence ),
                        "remediation": "Registrar el error mediante log o implementar una estrategia de compensacion explicita.",
                        "astVerified": true
                    } );
                }
            }
        } catch ( any e ) {
            // Failsafe pasivo ante variaciones de esquema AST
        }
    }

    private void function checkInvocations( required any rootNode, required array lines, required array issues ) {
        try {
            // Metodos (BoxMethodInvocation)
            var methods = arguments.rootNode.getDescendantsOfType( variables.methodInvClass );
            for ( var m in methods ) {
                var mName = !isNull( m.getName() ) ? m.getName().getName() : "";
                var src   = m.getSourceText();
                var pos   = m.getPosition();
                var lineNum = ( !isNull( pos ) && !isNull( pos.getStart() ) ) ? pos.getStart().getLine() : 1;
                var evidence = ( arrayLen( arguments.lines ) >= lineNum && lineNum >= 1 ) ? ( arguments.lines[ lineNum ] ?: "" ) : src;

                if ( mName == "readObject" ) {
                    arrayAppend( arguments.issues, {
                        "line"       : max( 1, lineNum ),
                        "code"       : "INSECURE_DESERIALIZATION",
                        "severity"   : "CRITICAL",
                        "description": "Deserializacion insegura detectada en llamada AST .readObject() (CWE-502)",
                        "evidence"   : trim( evidence ),
                        "remediation": "Evitar deserializar flujos de bytes no confiables con ObjectInputStream. Usar serializadores seguros como JSON.",
                        "astVerified": true
                    } );
                } else if ( mName == "exec" && findNoCase( "getRuntime", src ) ) {
                    arrayAppend( arguments.issues, {
                        "line"       : max( 1, lineNum ),
                        "code"       : "DANGEROUS_SYSTEM_CALL",
                        "severity"   : "CRITICAL",
                        "description": "Llamada a ejecucion de procesos del sistema operativo via Runtime.exec() (CWE-78)",
                        "evidence"   : trim( evidence ),
                        "remediation": "Evitar ejecucion de comandos arbitrarios del sistema operativo o aislar en sandbox.",
                        "astVerified": true
                    } );
                }
            }

            // Funciones globales (BoxFunctionInvocation)
            var funcs = arguments.rootNode.getDescendantsOfType( variables.funcInvClass );
            for ( var fn in funcs ) {
                var fnName = !isNull( fn.getName() ) ? fn.getName().getName() : "";
                if ( fnName == "cfexecute" || fnName == "executeCommandLine" ) {
                    var pos = fn.getPosition();
                    var lineNum = ( !isNull( pos ) && !isNull( pos.getStart() ) ) ? pos.getStart().getLine() : 1;
                    var evidence = ( arrayLen( arguments.lines ) >= lineNum && lineNum >= 1 ) ? ( arguments.lines[ lineNum ] ?: "" ) : fn.getSourceText();

                    arrayAppend( arguments.issues, {
                        "line"       : max( 1, lineNum ),
                        "code"       : "DANGEROUS_SYSTEM_CALL",
                        "severity"   : "CRITICAL",
                        "description": "Llamada a ejecucion de comandos del sistema operativo via [" & fnName & "] (CWE-78)",
                        "evidence"   : trim( evidence ),
                        "remediation": "Reemplazar por APIs controladas o validar estrictamente argumentos contra lista blanca.",
                        "astVerified": true
                    } );
                }
            }
        } catch ( any e ) {
            // Failsafe
        }
    }

    private void function checkConcurrentMutations( required any rootNode, required array lines, required array issues ) {
        try {
            var assignments = arguments.rootNode.getDescendantsOfType( variables.assignmentClass );
            for ( var asg in assignments ) {
                var leftNode = asg.getLeft();
                var leftSrc  = !isNull( leftNode ) ? ( leftNode.toString() & " " & ( leftNode.getSourceText() ?: "" ) ) : "";

                // Chequear si se muta application.* o server.* (ambitos globales compartidos entre peticiones)
                var isShared = ( findNoCase( "application.", leftSrc ) > 0 || findNoCase( "server.", leftSrc ) > 0 );
                if ( isShared ) {
                    // Verificar si alguno de sus ancestros es un BoxComponent de tipo lock
                    var ancestors = asg.getAncestors();
                    var isInsideLock = false;
                    for ( var anc in ancestors ) {
                        if ( anc.getClass().equals( variables.componentClass ) ) {
                            var compName = !isNull( anc.getName() ) ? anc.getName() : "";
                            if ( compName == "lock" ) {
                                isInsideLock = true;
                                break;
                            }
                        }
                    }

                    if ( !isInsideLock ) {
                        var pos = asg.getPosition();
                        var lineNum = ( !isNull( pos ) && !isNull( pos.getStart() ) ) ? pos.getStart().getLine() : 1;
                        var evidence = ( arrayLen( arguments.lines ) >= lineNum && lineNum >= 1 ) ? ( arguments.lines[ lineNum ] ?: "" ) : asg.getSourceText();

                        arrayAppend( arguments.issues, {
                            "line"       : max( 1, lineNum ),
                            "code"       : "UNSAFE_CONCURRENT_MUTATION",
                            "severity"   : "HIGH",
                            "description": "Modificacion de estado compartido sin bloque lock circundante (AST verificado)",
                            "evidence"   : trim( evidence ),
                            "remediation": "Envolver la modificacion en un bloque lock (exclusivo o de lectura) o usar estructuras concurrentes.",
                            "astVerified": true
                        } );
                    }
                }
            }
        } catch ( any e ) {
            // Failsafe
        }
    }

}
